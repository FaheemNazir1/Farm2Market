# ============================================================
# Farm2Market Backend - Environment Configuration Template
# ============================================================

# Server Port (Render sets PORT automatically, 5002 for local dev)
PORT=5002
NODE_ENV=production

# Database (MongoDB Atlas Connection String)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/farm2market?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_secure_random_jwt_secret_key
JWT_EXPIRE=7d

# Firebase Admin Authentication (for Google OAuth ID Token Verification)
FIREBASE_PROJECT_ID=farm2market-549b1
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Payment Gateways (Optional / Test Mode)
RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_SECRET=yourRazorpaySecret
STRIPE_SECRET_KEY=sk_test_yourStripeKey
STRIPE_WEBHOOK_SECRET=whsec_yourStripeWebhookSecret

# Client URL (Your deployed Vercel frontend URL for CORS)
# Example: https://farm2market.vercel.app
CLIENT_URL=https://your-app.vercel.app