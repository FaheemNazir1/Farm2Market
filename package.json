{
  "name": "farm2market",
  "version": "1.0.0",
  "description": "A Digital Bridge for Maximizing Farmer Profits - Smart India Hackathon 2025",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "start:server": "node server/index.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run start --prefix client",
    "server": "npm run dev --prefix server",
    "client": "npm run start --prefix client",
    "build": "node scripts/vercel-build.js",
    "build:client": "npm run build --prefix client",
    "build:server": "npm install --prefix server --production",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm run test --prefix server",
    "test:client": "npm run test --prefix client -- --watchAll=false",
    "test:automated": "node tests/automated/test-4-features.js",
    "test:crop-description": "node tests/automated/test-crop-description-validation.js",
    "test:farmer-buying": "node tests/automated/test-farmer-buying-and-google-auth.js",
    "test:cart": "node tests/automated/test-cart-flow.js",
    "test:cart-isolation": "node tests/automated/test-cart-checkout-cod-isolation.js",
    "test:razorpay": "node tests/automated/test-razorpay-integration.js"
  },
  "keywords": [
    "agriculture",
    "farmers",
    "marketplace",
    "e-commerce",
    "smart-india",
    "full-stack",
    "react",
    "node"
  ],
  "author": "Farm2Market Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3"
  }
}
